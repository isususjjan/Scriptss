local PASSWORD = 'Brlin2026'   -- 🔑 كلمة السر
local URL = 'https://raw.githubusercontent.com/USERNAME/REPO/main/BrlinRocket.lua'  -- 🌐 بدّل الرابط!

local SCRIPT_DIR = gg.getFile():match('^(.*)/')
local CACHE_FILE = SCRIPT_DIR .. '/BrlinCache.lua'

-- ═══════════ 🔑 كلمة السر ═══════════
local function PasswordScreen()
  for i = 1, 3 do
    local p = gg.prompt({'🔑 ادخل كلمة السر:'}, {[1] = ''}, {'text'})
    if p == nil then
      gg.toast('👋 باي باي!')
      gg.sleep(500)
      os.exit()
    end
    if p[1] == PASSWORD then
      gg.toast('✅ أهلاً يا Brlin 👑')
      gg.sleep(600)
      return
    end
    local left = 3 - i
    if left > 0 then
      gg.alert('❌ كلمة السر غلط!\nمحاولات باقية: ' .. left)
    else
      gg.alert('⛔ انتهت المحاولات')
      os.exit()
    end
  end
end

-- ═══════════ 🌐 جلب الكود من السيرفر ═══════════
local function FetchCode()
  gg.toast('🌐 جارٍ جلب الكود من السيرفر...')
  local res = gg.makeRequest(URL)
  if res ~= nil and res.code == 200 and res.message ~= nil and #res.message > 10 then
    -- نجح التحميل — خزّن نسخة احتياطية للأوفلاين
    local f = io.open(CACHE_FILE, 'w')
    if f then
      f:write(res.message)
      f:close()
    end
    return res.message, true
  end
  -- فشل التحميل — جرب النسخة المحفوظة
  local f = io.open(CACHE_FILE, 'r')
  if f then
    local cached = f:read('*a')
    f:close()
    if cached ~= nil and #cached > 10 then
      local c = gg.alert('⚠️ ما قدرت أوصل للسيرفر!\n\nتشغل النسخة المحفوظة (أوفلاين)؟', '✅ نعم شغلها', '❌ لا')
      if c == 1 then return cached, false end
    end
  end
  return nil, false
end

-- ═══════════ ▶️ التشغيل ═══════════
gg.setVisible(false)
gg.toast('🌐 BR LIN LOADER — جارٍ التشغيل...')
gg.sleep(500)
PasswordScreen()

local code, online = FetchCode()
if code == nil then
  gg.alert('❌ ما حصلت أي كود!\n\n✔️ تأكد من الإنترنت\n✔️ تأكد أن الرابط RAW وصح')
  os.exit()
end

local fn = (loadstring or load)(code)
if fn == nil then
  gg.alert('❌ الكود اللي بالسيرفر فيه خطأ!\nراجع الملف على GitHub')
  os.exit()
end

gg.toast(online and '🟢 متصل — الكود وصل مباشرة من السيرفر!' or '🟡 أوفلاين — تشغل النسخة المحفوظة')
gg.sleep(700)
fn()  -- 🚀 تنفيذ الكود الحقيقي من السيرفر
