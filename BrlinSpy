HackingIsTheGame = 0

gg.clearResults()
gg.setRanges(gg.REGION_C_DATA)
gg.searchNumber("-450891772", gg.TYPE_DWORD, false, gg.SIGN_EQUAL, 0, -1, 0)
pcall(gg.setVisible, false)

local gg = gg

function getShortName(str)
  local a = str:gsub('.+/', '')
  if a:find(':') then a= a:gsub(':.+', '') end
  return a
end

function getLibAndBase(var)
  local name, base = {}, {}
  for i, v in ipairs(var) do
    if v.type:sub(3,3)=='x' then
      local a={{address=v.start,flags=4}}
      local a = gg.getValues(a)
      if a[1].value==0x464C457F then
        table.insert(name, getShortName(v.internalName))
        table.insert(base, v.start)
      end
    end
  end
  return name, base
end

function checkAndReturn()
  local res = gg.getResults(gg.getResultsCount())
  if #res==0 then return nil, 'search found nothing (value not in C_DATA)' end

  local pk = gg.getTargetInfo().packageName
  local lib = gg.getRangesList('/data/*'..pk..'*.so')
  if #lib==0 then
    if #gg.getRangesList('/data/*'..pk..'*.apk')>0 then
      return nil, 'this is a split apk, script cant get the valid lib name'
    end
    return nil, 'no lib is found'
  end

  local name, base = getLibAndBase(lib)
  local finish = string.char(101, 110, 100)
  local t={}
  for i, v in ipairs(res) do
    for a, b in ipairs(lib) do
      if v.address>=b.start and v.address<b[finish] then
        for c, d in ipairs(name) do
          local sn = getShortName(b.internalName)
          if sn==d then
            v.lib=d
            v.offset='0x'..string.format('%x', v.address-base[c])
            table.insert(t, v)
          end
        end
      end
    end
  end
  return t
end

local valueTable, reason = checkAndReturn()

-- 🛡️ SAFETY: nothing found → clean message, NO crash
if type(valueTable) ~= 'table' or #valueTable == 0 then
  local why = reason or ('results exist but none matched a valid lib ('..gg.getResultsCount()..' results)')
  error('BrlinSpy failed - '..why, 0)
end


local summary = ''
for i, v in ipairs(valueTable) do
  local line = v.lib..'    |    '..v.offset
  pcall(gg.alert, line)
  pcall(gg.copyText, line)
  summary = summary..i..') '..line..'\n'
end


HackingIsTheGame = 1


pcall(gg.clearResults)
pcall(gg.setVisible, true)

if gg.print ~= nil then
  pcall(gg.print, 'BRLIN HOOK OFFSETS ('..#valueTable..')\n'..summary)
end

pcall(gg.copyText, summary)


pcall(gg.alert, 'BRLIN HOOK OFFSETS ('..#valueTable..')\n\n'..summary..'\n📋 Full summary copied to clipboard!')

pcall(gg.toast, '✅ Done — '..#valueTable..' offset(s)')
