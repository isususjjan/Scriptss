    👑 Brlin Funny Gamer  |  🤝 Z.ai]]

gg.setVisible(false)

function getShortName(str)
  local a = str:gsub('.+/', '')
  if a:find(':') then a = a:gsub(':.+', '') end
  return a
end

local ok, err = pcall(function()

  gg.toast('🧪 STEP 1: search starting...')
  gg.clearResults()
  gg.setRanges(gg.REGION_C_DATA)
  gg.searchNumber("-450891772", gg.TYPE_DWORD, false, gg.SIGN_EQUAL, 0, -1, 0)

  local count = gg.getResultsCount()
  gg.toast('🧪 STEP 2: search done — results = ' .. tostring(count))

  if count == 0 then
    gg.alert('🧪 RESULT: the search found NOTHING.\n(This is not a crash — maybe wrong value or region)')
    return
  end

  local res = gg.getResults(count)
  gg.toast('🧪 STEP 3: getResults OK — # = ' .. #res)

  gg.toast('🧪 STEP 4: reading target info...')
  local pk = tostring(gg.getTargetInfo().packageName)
  gg.toast('🧪 STEP 5: package = ' .. pk)

  local lib = gg.getRangesList('/data/*'..pk..'*.so')
  gg.toast('🧪 STEP 6: lib ranges found = ' .. #lib)

  if #lib == 0 then
    local apk = gg.getRangesList('/data/*'..pk..'*.apk')
    gg.alert('🧪 NO .so RANGES FOUND!\npackage = ' .. pk .. '\napk ranges = ' .. #apk)
    return
  end

  local name, base = {}, {}
  for i, v in ipairs(lib) do
    local t = tostring(v.type)
    if t:sub(3,3) == 'x' then
      local a = {{address = v.start, flags = 4}}
      a = gg.getValues(a)
      if a[1].value == 0x464C457F then
        table.insert(name, getShortName(v.internalName))
        table.insert(base, v.start)
      end
    end
  end
  gg.toast('🧪 STEP 7: valid libs = ' .. #name)

  if #name == 0 then
    gg.alert('🧪 Ranges exist but no valid ELF lib found!')
    return
  end

  local t = {}
  for i, v in ipairs(res) do
    for a, b in ipairs(lib) do
      if v.address >= b.start and v.address < b['end'] then
        for c, d in ipairs(name) do
          local sn = getShortName(b.internalName)
          if sn == d then
            v.lib = d
            v.offset = '0x' .. string.format('%x', v.address - base[c])
            table.insert(t, v)
          end
        end
      end
    end
  end
  gg.toast('🧪 STEP 8: matched hook offsets = ' .. #t)

  if #t == 0 then
    gg.alert('🧪 Search results exist but matched NO lib!\ncount = ' .. count)
    return
  end

  for i, v in ipairs(t) do
    gg.alert(v.lib .. '    |    ' .. v.offset)
  end

  gg.clearResults()
end)

gg.setVisible(true)

if ok then
  HackingIsTheGame = 1   -- 🚩 success flag — loader needs this!
  gg.toast('🧪 DEBUG: ALL STEPS PASSED ✅')
else
  gg.alert('🧪🧪 CRASH LOCATION FOUND! 🧪🧪\n\nThe script died with this error:\n\n' .. tostring(err) .. '\n\n📸 Send this to Z.ai!', 'EXIT')
  print('DEBUG CRASH: ' .. tostring(err))
end
